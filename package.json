{
  "name": "logger",
  "description": "Simple browser component-based logger",
  "version": "1.0.1",
  "author": "Joost Lubach",
  "private": false,
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "npm run clean && npm run build:tsc",
    "build:tsc": "npm run build:tsc:esm && npm run build:tsc:cjs",
    "build:tsc:esm": "tsc -p tsconfig.prod.json --module es2022 --outDir dist/esm --declarationDir dist/types",
    "build:tsc:cjs": "tsc -p tsconfig.prod.json --module commonjs --outDir dist/cjs --declaration false --declarationMap false",
    "clean": "rimraf dist",
    "lint": "eslint",
    "check": "tsc -p . --noEmit",
    "test": "vitest"
  },
  "peerDependencies": {
    "react": "^19.1",
    "react-dom": "^19.1"
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "react-timer": "workspace:^",
    "scroll-into-view": "^1.16.2",
    "uuid": "^9.0.1",
    "ytil": "workspace:^"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.0",
    "@types/node": "^25.0.3",
    "@types/uuid": "^9.0.8",
    "copyfiles": "^2.4.1",
    "rimraf": "^5.0.5",
    "tsc-alias": "^1.8.8",
    "typescript": "5.4.3",
    "ytil": "workspace:^"
  },
  "packageManager": "pnpm@9.9.0"
}
